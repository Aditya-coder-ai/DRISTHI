# =====================================================================
# DRISTHI Central Backend & Database Configuration
# =====================================================================

# Server Mode
DEBUG=false
PROJECT_NAME="DRISTHI Central Backend & Threat Telemetry"

# Database Configuration
# PostgreSQL Production Example:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/drishti
# SQLite Local Development / Testing:
DATABASE_URL=sqlite:///var/data/drishti_central.db

# Authentication Secret for Ingestion (Shared with Person 1's collector daemon)
# Leave empty for unauthenticated development, or set a secure token:
BACKEND_API_KEY=your_backend_api_key

# Webhook Signing Secret (Required in production when verifying Stripe webhooks)
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Session Idle Timeout (seconds before session marks closed)
SESSION_IDLE_TIMEOUT_SECONDS=1800

# =====================================================================
# CORS Configuration (Person 3 — React Frontend Integration)
# =====================================================================
# Comma-separated list of allowed frontend origins.
# Add every origin that the React dev server or deployed frontend uses.
# Development (Vite default port 5173, CRA default port 3000):
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000
# Production example (append to the comma list or replace entirely):
# FRONTEND_ORIGINS=https://dashboard.dristhi.internal,https://dristhi.example.com
