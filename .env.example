# =====================================================================
# Deception Assets & Honeypot Infrastructure - Configuration Template
# =====================================================================

# Environment mode: development, staging, production
DECEPTION_ENV=development
LOG_LEVEL=INFO

# ---------------------------------------------------------------------
# Phase 1: SSH Deception Service (Cowrie)
# ---------------------------------------------------------------------
SSH_HONEYPOT_ENABLED=true
SSH_LISTEN_HOST=0.0.0.0
SSH_LISTEN_PORT=2222
SSH_HOSTNAME=finance-server
SSH_LOG_DIR=var/log/cowrie

# ---------------------------------------------------------------------
# Phase 2: FTP Deception Service
# ---------------------------------------------------------------------
FTP_HONEYPOT_ENABLED=true
FTP_LISTEN_HOST=0.0.0.0
FTP_LISTEN_PORT=2121
FTP_SERVER_NAME=Corp-Storage-Node-02
FTP_LOG_DIR=var/log/ftp

# ---------------------------------------------------------------------
# Phase 3: Web Admin Portal Deception
# ---------------------------------------------------------------------
WEB_HONEYPOT_ENABLED=true
WEB_LISTEN_HOST=0.0.0.0
WEB_LISTEN_PORT=8080
WEB_PORTAL_NAME="Apex Internal Management System"
WEB_LOG_DIR=var/log/web

# ---------------------------------------------------------------------
# Central Backend Integration (Person 2)
# ---------------------------------------------------------------------
BACKEND_API_URL=http://localhost:8000/api/events
BACKEND_API_KEY=
EVENT_BATCH_SIZE=50
RETRY_LIMIT=5

