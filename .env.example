# =====================================================================
# Deception Assets & Honeypot Infrastructure - Configuration Template
# =====================================================================

# Environment mode: development, staging, production
DECEPTION_ENV=development
LOG_LEVEL=INFO

# ---------------------------------------------------------------------
# Phase 1: SSH Deception Service (Cowrie)
# ---------------------------------------------------------------------
SSH_HONEYPOT_ENABLED=true
SSH_LISTEN_HOST=0.0.0.0
SSH_LISTEN_PORT=2222
SSH_HOSTNAME=finance-server
SSH_LOG_DIR=services/ssh/var/log/cowrie

# ---------------------------------------------------------------------
# Central Backend Integration (Person 2)
# ---------------------------------------------------------------------
BACKEND_API_URL=http://localhost:8000/api/events
BACKEND_API_KEY=
EVENT_BATCH_SIZE=50
RETRY_LIMIT=5
